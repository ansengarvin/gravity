{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableVulnerabilityAlerts",
    ":disableDependencyDashboard"
  ],
  "gitAuthor": "agar-helper[bot] <359351858+agar-helper[bot]@users.noreply.github.com>",
  "prHourlyLimit": 0,
  "constraints": { "npm": "^11" },
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "packageRules": [
    { "matchManagers": ["github-actions"], "groupName": "github actions" },
    { "matchPackageNames": ["vite", "@vitejs/**"], "groupName": "vite" },
    { "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"], "groupName": "react" },
    {
      "matchPackageNames": [
        "typescript",
        "eslint",
        "@eslint/**",
        "eslint-plugin-*",
        "typescript-eslint",
        "@typescript-eslint/**"
      ],
      "groupName": "typescript and eslint"
    },
    {
      "description": "typescript-eslint doesn't support TypeScript 7 yet (peer <6.1.0 as of 8.73.0). Lift once it does.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    { "matchManagers": ["renovate-config"], "matchDepNames": ["npm"], "enabled": false }
  ]
}
